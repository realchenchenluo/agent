# Server-side Worker configuration example. Production remains on Cloudflare.
# Never place actual keys in this file, Wrangler vars, Git, browser assets or logs.
# Inject keys with: wrangler secret put LLM_A_API_KEY --config wrangler.jsonc
# cloudflare is the unchanged default. hybrid uses Workers AI first, then at
# most one approved A/B backup. external selects A/B without Workers AI.
LLM_GATEWAY_MODE=cloudflare
LLM_PAID_PROVIDER_APPROVED=false
LLM_PRIMARY=A
LLM_CNY_PER_USD_CAP=<verified-conservative-fx-rate>
# For the separate Beijing Qwen candidate, use providers.qwen.env.example.
# Explicit CNY prices use INPUT_CNY/OUTPUT_CNY_PER_MILLION and fx=1 internally.
# Never mix USD and CNY price fields in one slot.

LLM_A_PROVIDER=openai
LLM_A_PROTOCOL=chat-completions
LLM_A_BASE_URL=https://api.openai.com/v1
LLM_A_MODEL=<verified-chat-completions-model-id>
LLM_A_API_KEY=<Cloudflare-Secret-only>
LLM_A_PROTOCOL_VERIFIED=false
LLM_A_JSON_VERIFIED=false
LLM_A_STREAM_VERIFIED=false
LLM_A_BILLING_BOUNDS_VERIFIED=false
LLM_A_INPUT_USD_PER_MILLION=<official-uncached-input-peak-price>
LLM_A_OUTPUT_USD_PER_MILLION=<official-output-peak-price>
LLM_A_CONNECT_TIMEOUT_MS=8000
LLM_A_RESPONSE_TIMEOUT_MS=45000
LLM_A_MAX_OUTPUT_TOKENS=1024
LLM_A_MAX_MESSAGE_CHARS=12000
LLM_A_TEMPERATURE=omit
LLM_A_JSON_MODE=prompt
LLM_A_MAX_ATTEMPTS=1
LLM_A_DAILY_MAX_CALLS=<approved-positive-integer>
LLM_A_DAILY_CAP_CENTS=<approved-cents-within-stage-budget>

LLM_B_PROVIDER=deepseek
LLM_B_PROTOCOL=chat-completions
LLM_B_BASE_URL=https://api.deepseek.com
LLM_B_MODEL=<verified-chat-completions-model-id>
LLM_B_API_KEY=<Cloudflare-Secret-only>
LLM_B_PROTOCOL_VERIFIED=false
LLM_B_JSON_VERIFIED=false
LLM_B_STREAM_VERIFIED=false
LLM_B_BILLING_BOUNDS_VERIFIED=false
LLM_B_INPUT_USD_PER_MILLION=<official-uncached-input-peak-price>
LLM_B_OUTPUT_USD_PER_MILLION=<official-output-peak-price>
LLM_B_CONNECT_TIMEOUT_MS=8000
LLM_B_RESPONSE_TIMEOUT_MS=45000
LLM_B_MAX_OUTPUT_TOKENS=1024
LLM_B_MAX_MESSAGE_CHARS=12000
LLM_B_TEMPERATURE=0
LLM_B_JSON_MODE=json_object
LLM_B_MAX_ATTEMPTS=1
LLM_B_DAILY_MAX_CALLS=<approved-positive-integer>
LLM_B_DAILY_CAP_CENTS=<approved-cents-within-stage-budget>
