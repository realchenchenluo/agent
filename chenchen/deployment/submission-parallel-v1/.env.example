# Copy to .env locally. Never commit real values.
PUBLIC_ORIGIN=https://app.YOUR-DOMAIN.cn
# Optional China Network hostname; separate browser sessions, shared backend budget.
ADDITIONAL_PUBLIC_ORIGINS=
PUBLIC_HOSTS=app.YOUR-DOMAIN.cn
PORT=4188
BIND_HOST=0.0.0.0
SQLITE_PATH=/data/disabled.sqlite
SESSION_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
RISK_HMAC_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_64_HEX_CHARACTERS
PROXY_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_64_HEX_CHARACTERS
RELEASE_ID=submission-parallel-v1-20261029

# disabled = no model requests. demo = fixed, clearly labelled synthetic response.
# external = existing unified gateway; requires separate real-call approval/config.
SUBMISSION_MODEL_MODE=disabled
SUBMISSION_EXTERNAL_APPROVED=false
MODEL_ENABLED=false
LLM_PAID_PROVIDER_APPROVED=false
DEMO_START_AT=2026-10-29T00:00:00+08:00
DEMO_END_AT=2026-11-30T00:00:00+08:00
# Local caps are safeguards, NOT new paid-call authorization or a new allowance.
DEMO_BUDGET_CENTS=50
DAILY_BUDGET_CENTS=20
RISK_TRANSPORT=local-readonly
# HTTPS mode: exact signed amount-risk.v1 /assess endpoint; no redirects.
# RISK_TRANSPORT=https
# RISK_SERVICE_URL=https://risk.YOUR-DOMAIN.cn/assess

# Copy verified external provider fields from the existing providers template.
# Put LLM_A_API_KEY in server secret manager or private env file, never the UI.
