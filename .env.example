# Copy only the names you need into your own untracked environment configuration.
# The Node server does not load this file automatically. All values below are examples.

# Local synthetic demo (required for the README walkthrough; never use for public access).
MOT_LOCAL_DEMO=true
MOT_SCHEDULER_ENABLED=false
PORT=4175
# Optional: set each run to a fresh writable directory to reset synthetic facts.
MOT_DATA_DIR=./local-data/mot
APP_DATA_DIR=./local-data/conversations

# Token mode for a private test deployment. Required when MOT_LOCAL_DEMO is not enabled.
# Use a unique 24+ character token and only synthetic owner IDs; keep real values in a secret store.
MOT_AUTH_TOKENS_JSON=[{"owner_id":"synthetic-owner","token":"<secret-token-24-plus-chars>","roles":["read","operator","approver","ingestor"]}]

# Cloudflare MOT Staging only. Configure as Worker Secrets, never as committed vars.
APP_STAGING_PASSWORD=<secret-demo-passphrase-24-plus-chars>
APP_STAGING_COOKIE_KEY=<secret-cookie-signing-key-32-plus-chars>
MOT_CRON_SECRET=<secret-cron-key-24-plus-chars>
# Set to the tested source commit when deploying, then verify authenticated /api/mot/health.
MOT_BUILD_SHA=<tested-git-commit-sha>

# Leave production/public serving disabled for the local synthetic demo.
PUBLIC_ACCESS=false
