# Candidate only: no keys, no paid calls, no deployment approval.
# Keep the existing Cloudflare route until separately approved staging checks.
LLM_GATEWAY_MODE=cloudflare
LLM_PAID_PROVIDER_APPROVED=false
LLM_PRIMARY=A

# Copy the exact API Host from your Beijing workspace. Never use this placeholder.
LLM_A_PROVIDER=bailian
LLM_A_PROTOCOL=chat-completions
LLM_A_REGION=cn-beijing
LLM_A_BASE_URL=https://llm-REPLACE-WITH-WORKSPACE.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_A_MODEL=qwen3.8-flash
LLM_A_ENABLE_THINKING=false
LLM_A_JSON_MODE=json_object
LLM_A_TEMPERATURE=omit
LLM_A_CONNECT_TIMEOUT_MS=8000
LLM_A_RESPONSE_TIMEOUT_MS=45000
LLM_A_MAX_OUTPUT_TOKENS=1024
LLM_A_MAX_MESSAGE_CHARS=12000
LLM_A_MAX_ATTEMPTS=2

# CNY per million tokens. Official Beijing list prices checked 2026-10-25.
# https://help.aliyun.com/zh/model-studio/model-pricing
# Recheck before paid testing; list prices are not an account balance or invoice.
LLM_A_PRICE_CURRENCY=CNY
LLM_A_INPUT_CNY_PER_MILLION=0.8
LLM_A_OUTPUT_CNY_PER_MILLION=2.7
LLM_A_PROTOCOL_VERIFIED=false
LLM_A_JSON_VERIFIED=false
LLM_A_STREAM_VERIFIED=false
LLM_A_BILLING_BOUNDS_VERIFIED=false
LLM_A_DAILY_MAX_CALLS=<requires-separate-approval>
LLM_A_DAILY_CAP_CENTS=<requires-separate-approval>

# Secret name: LLM_A_API_KEY. Inject into the approved staging Worker only.
# Do not add its value here, to Wrangler vars, Git, screenshots, or chat.
# Provider B is deliberately absent. Do not copy B from providers.env.example.
# Existing overall/daily budget and ledger remain authoritative and unchanged.
