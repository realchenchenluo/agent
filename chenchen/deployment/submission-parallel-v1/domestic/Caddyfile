{$PUBLIC_HOSTS} {
    request_body {
        max_size 16KB
    }
    reverse_proxy 127.0.0.1:4188 {
        flush_interval -1
        header_up X-Submission-Proxy {$PROXY_SECRET}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto https
        transport http {
            response_header_timeout 180s
        }
    }
}
